# .github/docker/Dockerfile.asan
# Defines the reproducible build environment for the ASAN CI job.

# Use a specific version of Ubuntu for consistency.
FROM ubuntu:20.04 as dev-base

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies, including python, pip, clang, and git
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    clang \
    git \
    ccache \
    ninja-build \
    python3.9 \
    python3.9-dev \
    python3-pip && \
    rm -rf /var/lib/apt/lists/*

# Make python3.9 the default python
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1 && \
    update-alternatives --set python3 /usr/bin/python3.9

# Upgrade pip and install wheel
RUN python3 -m pip install --upgrade pip wheel

# Set up the working directory
WORKDIR /workspace

# Copy and install Python dependencies first to leverage Docker layer caching.
# This layer will only be rebuilt if requirements.txt changes.
COPY requirements.txt requirements-build.txt .
RUN pip install -r requirements.txt
RUN pip install mkl-static mkl-include pytest

FROM dev-base as submodule-update
WORKDIR /workspace
COPY . .
RUN git submodule update --init --recursive

From submodule-update as final-layer
# Copy the rest of the repository content into the container
COPY . .

